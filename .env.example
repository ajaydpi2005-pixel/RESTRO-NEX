# ──────────────────────────────────────────────────────────────────────
# RestroNex environment variables
# Copy to .env.local for local development. NEVER commit real secrets.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# ──────────────────────────────────────────────────────────────────────

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Phase 1 — Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only. Full database access — must never reach the client.
SUPABASE_SERVICE_ROLE_KEY=""

# Phase 18 — External integrations. Per-tenant credentials are entered in Settings, not here.
# Encryption key for stored integration credentials: 32 random bytes, base64.
#   Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# INTEGRATION_ENCRYPTION_KEY=""
# Bearer secret that the job scheduler sends to POST /api/integrations/worker (32+ characters).
# INTEGRATION_WORKER_SECRET=""

# Phase 20 — Payment provider (Razorpay or equivalent)
# PAYMENT_KEY_ID=""
# PAYMENT_KEY_SECRET=""
# PAYMENT_WEBHOOK_SECRET=""

# Phase 21 — Notification providers (email / SMS / WhatsApp)
# Configured when the notifications phase begins.
