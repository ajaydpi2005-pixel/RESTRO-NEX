# ──────────────────────────────────────────────────────────────────────
# RestroNex environment variables
# Copy to .env.local for local development. NEVER commit real secrets.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# ──────────────────────────────────────────────────────────────────────

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Phase 1 — Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only. Full database access — must never reach the client.
SUPABASE_SERVICE_ROLE_KEY=""

# Phase 20 — Payment provider (Razorpay or equivalent)
# PAYMENT_KEY_ID=""
# PAYMENT_KEY_SECRET=""
# PAYMENT_WEBHOOK_SECRET=""

# Phase 21 — Notification providers (email / SMS / WhatsApp)
# Configured when the notifications phase begins.
